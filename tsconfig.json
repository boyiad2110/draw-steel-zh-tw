{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["astro/client", "node", "vitest/globals"]
  },
  "include": [
    ".astro/types.d.ts",
    "schemas/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.astro",
    "src/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["dist"]
}
